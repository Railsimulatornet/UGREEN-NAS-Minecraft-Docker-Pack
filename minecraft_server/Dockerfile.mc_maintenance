FROM alpine:3.24

# Copyright Roman Glos 2026
# Maintenance image for the Minecraft Docker Pack
# Alpine 3.24 receives current patch releases through the minor-version tag.
# Installed packages are upgraded during each clean rebuild.
RUN set -eux; \
    apk update; \
    apk upgrade --no-cache; \
    apk add --no-cache \
        bash \
        coreutils \
        ca-certificates \
        tzdata \
        libarchive-tools \
        zip \
        unzip \
        jq \
        rsync \
        curl \
        findutils \
        python3 \
        py3-pip \
        lighttpd \
        docker-cli \
        util-linux \
        git; \
    update-ca-certificates; \
    [ -x /bin/bash ] || ln -sf /usr/bin/bash /bin/bash
