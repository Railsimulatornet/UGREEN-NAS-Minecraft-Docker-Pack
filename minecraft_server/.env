# ==================================================
# Minecraft Docker Pack
# DE: Umgebungsvariablen / EN: Environment Variables
# ==================================================
# DE: Diese Datei steuert den gesamten Stack.
# EN: This file controls the whole stack.
#
# DE: Reihenfolge der Bereiche:
# EN: Section order:
# DE: 1) Schnellstart, 2) Basis, 3) Pfade, 4) Server, 5) Backup,
# EN: 1) Quick start, 2) Base, 3) Paths, 4) Servers, 5) Backup,
# DE: 6) Benachrichtigungen, 7) Maintenance, 8) Erweitert.
# EN: 6) Notifications, 7) Maintenance, 8) Advanced.

# ==================================================
# 01) SCHNELLSTART / QUICK START
# ==================================================
# DE: Beispiele:
# EN: Examples:
# DE: Beide Server aktiv              -> COMPOSE_PROFILES=creative,survival
# EN: Both servers active             -> COMPOSE_PROFILES=creative,survival
# DE: Nur Creative aktiv              -> COMPOSE_PROFILES=creative
# EN: Only creative active            -> COMPOSE_PROFILES=creative
# DE: Nur Survival aktiv              -> COMPOSE_PROFILES=survival
# EN: Only survival active            -> COMPOSE_PROFILES=survival
# DE: Backups für alle aktiven Server -> BACKUP_TARGETS=active
# EN: Backups for all active servers  -> BACKUP_TARGETS=active
# DE: Nur Creative sichern            -> BACKUP_TARGETS=creative
# EN: Back up creative only           -> BACKUP_TARGETS=creative
# DE: Nur Apprise nutzen              -> NOTIFY_CHANNEL=apprise
# EN: Use Apprise only                -> NOTIFY_CHANNEL=apprise
# DE: Nur SMTP nutzen                 -> NOTIFY_CHANNEL=smtp
# EN: Use SMTP only                   -> NOTIFY_CHANNEL=smtp

# ==================================================
# 02) BASIS / BASE
# ==================================================
# DE: Zeitzone für alle Container.
# EN: Time zone for all containers.
STACK_TZ=Europe/Berlin

# DE: Gemeinsame Benutzer-ID für Dateien in den Server- und Backup-Volumes.
# EN: Shared user ID for files in the server and backup volumes.
COMMON_UID=1000

# DE: Gemeinsame Gruppen-ID für Dateien in den Server- und Backup-Volumes.
# EN: Shared group ID for files in the server and backup volumes.
COMMON_GID=10

# DE: Minecraft-EULA, muss auf TRUE stehen.
# EN: Minecraft EULA, must be set to TRUE.
MC_EULA=TRUE

# DE: Aktive Docker-Compose-Profile für die Minecraft-Server.
# EN: Active Docker Compose profiles for the Minecraft servers.
# DE: creative,survival = beide Server aktiv.
# EN: creative,survival = both servers enabled.
# DE: creative = nur Creative-Server aktiv.
# EN: creative = only the creative server is enabled.
# DE: survival = nur Survival-Server aktiv.
# EN: survival = only the survival server is enabled.
COMPOSE_PROFILES=creative,survival

# DE: Sprache der Maintenance-Ausgaben: de oder en.
# EN: Language of the maintenance output: de or en.
MAINTENANCE_LANG=de

# DE: Freier Host-Name für Reports und Warnungen.
# EN: Custom host name used in reports and alerts.
HOST_NAME=Ugreen NAS

# ==================================================
# 03) PROJEKTPFADE / PROJECT PATHS
# ==================================================
# DE: Host-Pfad für die Creative-Welt relativ zum Projektordner.
# EN: Host path for the creative world relative to the project directory.
CREATIVE_DATA_DIR=./creative/data

# DE: Host-Pfad für die Survival-Welt relativ zum Projektordner.
# EN: Host path for the survival world relative to the project directory.
SURVIVAL_DATA_DIR=./survival/data

# DE: Host-Pfad für die Backup-Konfiguration relativ zum Projektordner.
# EN: Host path for the backup configuration relative to the project directory.
BACKUP_CONFIG_DIR=./backup/config

# DE: Host-Pfad für die Backup-Daten relativ zum Projektordner.
# EN: Host path for the backup data relative to the project directory.
BACKUP_DATA_DIR=./backup/data

# DE: Host-Pfad für das lokale Addons-Repository relativ zum Projektordner.
# EN: Host path for the local addons repository relative to the project directory.
ADDONS_REPO_DIR=./addons_repo

# ==================================================
# 04) CREATIVE SERVER
# ==================================================
# DE: Docker-Image des Creative-Servers.
# EN: Docker image of the creative server.
CREATIVE_IMAGE=itzg/minecraft-bedrock-server:latest

# DE: Container-Name des Creative-Servers.
# EN: Container name of the creative server.
CREATIVE_CONTAINER_NAME=minecraftserver_creative

# DE: Sichtbarer Servername im Spiel.
# EN: Visible server name in the game.
CREATIVE_SERVER_NAME=SERVER

# DE: Name der Creative-Welt im Server und für Addons/Backups.
# EN: Name of the creative world inside the server and for addons/backups.
CREATIVE_LEVEL_NAME=creative

# DE: Externer UDP-Port für den Creative-Bedrock-Server.
# EN: External UDP port for the creative Bedrock server.
CREATIVE_HOST_PORT_UDP=19133

# DE: Externer SSH-Port des Creative-Containers.
# EN: External SSH port of the creative container.
CREATIVE_SSH_HOST_PORT=2222

# DE: Spielmodus des Creative-Servers.
# EN: Game mode of the creative server.
CREATIVE_GAMEMODE=creative

# DE: Erlaubt Cheats auf dem Creative-Server.
# EN: Allows cheats on the creative server.
CREATIVE_ALLOW_CHEATS=true

# DE: Kommagetrennte Liste der OP-Spieler.
# EN: Comma-separated list of operator players.
CREATIVE_OPS=

# DE: Minecraft-Bedrock-Version, z. B. LATEST.
# EN: Minecraft Bedrock version, for example LATEST.
CREATIVE_VERSION=LATEST

# DE: CPU-Limit des Creative-Servers, bewusst moderat gewählt und bei Bedarf erhöhbar.
# EN: CPU limit of the creative server, intentionally moderate and can be increased if needed.
CREATIVE_CPUS=2

# DE: RAM-Limit des Creative-Servers, bewusst moderat gewählt und bei Bedarf erhöhbar.
# EN: Memory limit of the creative server, intentionally moderate and can be increased if needed.
CREATIVE_MEM_LIMIT=4g

# DE: Restart-Policy des Creative-Servers.
# EN: Restart policy of the creative server.
CREATIVE_RESTART=always

# DE: Wartezeit vor einem erzwungenen Stop.
# EN: Grace period before a forced stop.
CREATIVE_STOP_GRACE_PERIOD=45s

# DE: Standard-Berechtigungsstufe neuer Spieler.
# EN: Default permission level for new players.
CREATIVE_DEFAULT_PLAYER_PERMISSION_LEVEL=visitor

# DE: Aktiviert Mojang-/Bedrock-Telemetrie.
# EN: Enables Mojang/Bedrock telemetry.
CREATIVE_EMIT_SERVER_TELEMETRY=true

# DE: Aktiviert Item-Transaktions-Logging.
# EN: Enables item transaction logging.
CREATIVE_ITEM_TRANSACTION_LOGGING_ENABLED=true

# DE: Aktiviert SSH im Creative-Container.
# EN: Enables SSH inside the creative container.
CREATIVE_ENABLE_SSH=true

# DE: Optionaler Seed der Creative-Welt.
# EN: Optional seed of the creative world.
CREATIVE_LEVEL_SEED=

# ==================================================
# 05) SURVIVAL SERVER
# ==================================================
# DE: Docker-Image des Survival-Servers.
# EN: Docker image of the survival server.
SURVIVAL_IMAGE=itzg/minecraft-bedrock-server:latest

# DE: Container-Name des Survival-Servers.
# EN: Container name of the survival server.
SURVIVAL_CONTAINER_NAME=minecraftserver_survival

# DE: Sichtbarer Servername im Spiel.
# EN: Visible server name in the game.
SURVIVAL_SERVER_NAME=SERVER

# DE: Name der Survival-Welt im Server und für Addons/Backups.
# EN: Name of the survival world inside the server and for addons/backups.
SURVIVAL_LEVEL_NAME=SURVIVAL

# DE: Externer TCP-Port für den Survival-Bedrock-Server.
# EN: External TCP port for the survival Bedrock server.
SURVIVAL_HOST_PORT_TCP=19132

# DE: Externer UDP-Port für den Survival-Bedrock-Server.
# EN: External UDP port for the survival Bedrock server.
SURVIVAL_HOST_PORT_UDP=19132

# DE: Externer SSH-Port des Survival-Containers.
# EN: External SSH port of the survival container.
SURVIVAL_SSH_HOST_PORT=2223

# DE: Spielmodus des Survival-Servers.
# EN: Game mode of the survival server.
SURVIVAL_GAMEMODE=survival

# DE: Schwierigkeitsgrad des Survival-Servers.
# EN: Difficulty of the survival server.
SURVIVAL_DIFFICULTY=easy

# DE: Kommagetrennte Liste der OP-Spieler.
# EN: Comma-separated list of operator players.
SURVIVAL_OPS=

# DE: Minecraft-Bedrock-Version, z. B. LATEST.
# EN: Minecraft Bedrock version, for example LATEST.
SURVIVAL_VERSION=LATEST

# DE: CPU-Limit des Survival-Servers, bewusst moderat gewählt und bei Bedarf erhöhbar.
# EN: CPU limit of the survival server, intentionally moderate and can be increased if needed.
SURVIVAL_CPUS=1.5

# DE: RAM-Limit des Survival-Servers, bewusst moderat gewählt und bei Bedarf erhöhbar.
# EN: Memory limit of the survival server, intentionally moderate and can be increased if needed.
SURVIVAL_MEM_LIMIT=3g

# DE: Restart-Policy des Survival-Servers.
# EN: Restart policy of the survival server.
SURVIVAL_RESTART=always

# DE: Wartezeit vor einem erzwungenen Stop.
# EN: Grace period before a forced stop.
SURVIVAL_STOP_GRACE_PERIOD=45s

# DE: Standard-Berechtigungsstufe neuer Spieler.
# EN: Default permission level for new players.
SURVIVAL_DEFAULT_PLAYER_PERMISSION_LEVEL=visitor

# DE: Aktiviert Mojang-/Bedrock-Telemetrie.
# EN: Enables Mojang/Bedrock telemetry.
SURVIVAL_EMIT_SERVER_TELEMETRY=true

# DE: Aktiviert Item-Transaktions-Logging.
# EN: Enables item transaction logging.
SURVIVAL_ITEM_TRANSACTION_LOGGING_ENABLED=true

# DE: Aktiviert SSH im Survival-Container.
# EN: Enables SSH inside the survival container.
SURVIVAL_ENABLE_SSH=true

# DE: Optionaler Seed der Survival-Welt.
# EN: Optional seed of the survival world.
SURVIVAL_LEVEL_SEED=

# ==================================================
# 06) BACKUP
# ==================================================
# DE: Docker-Image des Backup-Containers.
# EN: Docker image of the backup container.
BACKUP_IMAGE=kaiede/minecraft-bedrock-backup:latest

# DE: Container-Name des Backup-Containers.
# EN: Container name of the backup container.
BACKUP_CONTAINER_NAME=minecraftserver_backup

# DE: Auswahl der Backup-Ziele.
# EN: Selection of backup targets.
# DE: active = alle aktiven Minecraft-Profile sichern.
# EN: active = back up all active Minecraft profiles.
# DE: creative,survival = beide Welten sichern, sofern aktiv.
# EN: creative,survival = back up both worlds if active.
# DE: creative = nur Creative sichern, sofern aktiv.
# EN: creative = back up only creative if active.
# DE: survival = nur Survival sichern, sofern aktiv.
# EN: survival = back up only survival if active.
# DE: none = keine Welten sichern.
# EN: none = do not back up any worlds.
BACKUP_TARGETS=active

# DE: Backup-Intervall für Bedrockifier, z. B. 30m, 1h oder 6h.
# EN: Backup interval for Bedrockifier, for example 30m, 1h or 6h.
BACKUP_INTERVAL=30m

# DE: Mindestabstand zwischen zwei Backup-Läufen.
# EN: Minimum interval between two backup runs.
BACKUP_MIN_INTERVAL=30m

# DE: Startverzögerung für den ersten Backup-Lauf nach Containerstart.
# EN: Startup delay before the first backup run after container start.
BACKUP_STARTUP_DELAY=2m

# DE: true = direkt nach dem Start einen ersten Backup-Lauf ausführen.
# EN: true = run an initial backup shortly after startup.
BACKUP_RUN_INITIAL=true

# DE: Anzahl der Tage, für die alle Backups vollständig behalten werden.
# EN: Number of days for which all backups are kept in full.
BACKUP_TRIM_DAYS=7

# DE: Gesamtanzahl der Tage, für die Backups aufbewahrt werden.
# EN: Total number of days backups are retained.
BACKUP_KEEP_DAYS=14

# DE: Mindestanzahl an Backups, die pro Welt immer erhalten bleibt.
# EN: Minimum number of backups always kept per world.
BACKUP_MIN_KEEP=7

# DE: CPU-Limit des Backup-Containers, bewusst moderat gewählt.
# EN: CPU limit of the backup container, intentionally moderate.
BACKUP_CPUS=0.25

# DE: RAM-Limit des Backup-Containers, bewusst moderat gewählt.
# EN: Memory limit of the backup container, intentionally moderate.
BACKUP_MEM_LIMIT=512m

# DE: Restart-Policy des Backup-Containers.
# EN: Restart policy of the backup container.
BACKUP_RESTART=always

# DE: Verzögerung bis zum Start des Backup-Healthchecks.
# EN: Delay before the backup health check starts.
BACKUP_HEALTHCHECK_START_PERIOD=60s

# DE: Intervall des Backup-Healthchecks.
# EN: Interval of the backup health check.
BACKUP_HEALTHCHECK_INTERVAL=30s

# DE: Timeout des Backup-Healthchecks.
# EN: Timeout of the backup health check.
BACKUP_HEALTHCHECK_TIMEOUT=10s

# ==================================================
# 07) BENACHRICHTIGUNGEN / NOTIFICATIONS
# ==================================================
# DE: Benachrichtigungskanal.
# EN: Notification channel.
# DE: auto = zuerst SMTP, dann Apprise als Fallback.
# EN: auto = first SMTP, then Apprise as fallback.
# DE: smtp = nur SMTP.
# EN: smtp = SMTP only.
# DE: apprise = nur Apprise.
# EN: apprise = Apprise only.
# DE: none = keine Benachrichtigungen senden.
# EN: none = do not send notifications.
NOTIFY_CHANNEL=auto

# DE: SMTP-Server für Mailversand. Leer = SMTP nicht konfiguriert.
# EN: SMTP server for mail delivery. Empty = SMTP not configured.
SMTP_HOST=

# DE: SMTP-Port, z. B. 587 für STARTTLS oder 465 für SMTPS.
# EN: SMTP port, for example 587 for STARTTLS or 465 for SMTPS.
SMTP_PORT=587

# DE: SMTP-Benutzername, falls Authentifizierung benötigt wird.
# EN: SMTP username if authentication is required.
SMTP_USER=

# DE: SMTP-Passwort, falls Authentifizierung benötigt wird.
# EN: SMTP password if authentication is required.
SMTP_PASS=

# DE: 1 = STARTTLS verwenden, 0 = kein STARTTLS.
# EN: 1 = use STARTTLS, 0 = do not use STARTTLS.
SMTP_STARTTLS=1

# DE: 1 = direktes SMTPS verwenden, 0 = normales SMTP oder STARTTLS.
# EN: 1 = use direct SMTPS, 0 = normal SMTP or STARTTLS.
SMTP_USE_TLS=0

# DE: Absenderadresse für SMTP-Mails.
# EN: Sender address for SMTP mails.
MAIL_FROM=

# DE: Empfängeradresse(n) für Benachrichtigungen, Komma oder Semikolon möglich.
# EN: Recipient address(es) for notifications, comma- or semicolon-separated.
MAIL_TO=

# DE: Optionale Reply-To-Adresse für Antworten auf SMTP-Mails.
# EN: Optional reply-to address for replies to SMTP mails.
MAIL_REPLY_TO=

# DE: Vollständige Apprise-Notify-URL. Leer = Apprise nicht konfiguriert.
# EN: Full Apprise notify URL. Empty = Apprise not configured.
# DE: Beispiel: http://NAS-IP:8000/notify
# EN: Example: http://NAS-IP:8000/notify
APPRISE_URL=

# DE: Anzahl der Sende-Wiederholungen im Tagesreport notify.sh.
# EN: Number of send retries in the daily notify.sh report.
NOTIFY_RETRIES=5

# DE: Pause zwischen Sende-Wiederholungen in Sekunden.
# EN: Delay between send retries in seconds.
NOTIFY_RETRY_DELAY=5

# DE: Testmodus für notify.sh, 1 = nur Vorschau, kein Versand.
# EN: Test mode for notify.sh, 1 = preview only, no sending.
NOTIFY_DRY_RUN=0

# ==================================================
# 08) MAINTENANCE
# ==================================================
# DE: Container-Name des Maintenance-Containers.
# EN: Container name of the maintenance container.
MAINTENANCE_CONTAINER_NAME=minecraftserver_maintenance

# DE: CPU-Limit des Maintenance-Containers, bewusst moderat gewählt.
# EN: CPU limit of the maintenance container, intentionally moderate.
MAINTENANCE_CPUS=0.25

# DE: RAM-Limit des Maintenance-Containers, bewusst moderat gewählt.
# EN: Memory limit of the maintenance container, intentionally moderate.
MAINTENANCE_MEM_LIMIT=256m

# DE: Restart-Policy des Maintenance-Containers.
# EN: Restart policy of the maintenance container.
MAINTENANCE_RESTART=unless-stopped

# DE: Aktiviert automatische Restarts der Minecraft-Server nach Addon-Änderungen.
# EN: Enables automatic restarts of the Minecraft servers after addon changes.
MC_AUTO_RESTART=true

# DE: Maximale Anzahl angezeigter Einträge im Tagesreport.
# EN: Maximum number of entries shown in the daily report.
DISPLAY_LIMIT=200

# DE: Cooldown zwischen zwei automatischen Backup-Container-Restarts.
# EN: Cooldown between two automatic backup container restarts.
RESTART_COOLDOWN_SECS=1800

# DE: Startschutz des Watchdogs in Sekunden nach einem kompletten Neuaufbau oder Restart.
# EN: Watchdog bootstrap grace in seconds after a full redeploy or restart.
WATCHDOG_BOOT_GRACE_SECS=300

# DE: Schwellwert für den Backup-Watchdog in Sekunden.
# EN: Threshold for the backup watchdog in seconds.
WATCHDOG_MAX_AGE_SECS=3600

# DE: Maximales Alter des neuesten Backups, bevor es als veraltet gilt.
# EN: Maximum age of the newest backup before it is considered stale.
HEALTH_MAX_AGE_SECS=10800

# DE: Aktiviert Watchdog-Benachrichtigungen.
# EN: Enables watchdog notifications.
WATCHDOG_NOTIFY=1

# DE: Testmodus für den Watchdog, 1 = kein echter Restart.
# EN: Test mode for the watchdog, 1 = no real restart.
WATCHDOG_DRY_RUN=0

# ==================================================
# 09) ERWEITERT / ADVANCED
# ==================================================
# DE: Aktiviert WUD-/Watchtower-Labels zur Image-Überwachung.
# EN: Enables WUD/Watchtower labels for image monitoring.
WUD_WATCH_ENABLED=true

# DE: Digest-Prüfung für WUD, false = deaktiviert.
# EN: Digest checking for WUD, false = disabled.
WUD_WATCH_DIGEST=false

# DE: Setzt das Autoheal-Label auf unterstützten Containern.
# EN: Sets the autoheal label on supported containers.
AUTOHEAL_LABEL_ENABLED=true

# DE: Docker-Image des Autoheal-Containers.
# EN: Docker image of the autoheal container.
AUTOHEAL_IMAGE=willfarrell/autoheal:latest

# DE: Container-Name des Autoheal-Containers.
# EN: Container name of the autoheal container.
AUTOHEAL_CONTAINER_NAME=minecraftserver_autoheal

# DE: Restart-Policy des Autoheal-Containers.
# EN: Restart policy of the autoheal container.
AUTOHEAL_RESTART=always

# DE: Prüfintervall von Autoheal in Sekunden.
# EN: Autoheal check interval in seconds.
AUTOHEAL_INTERVAL=30

# DE: Startverzögerung von Autoheal in Sekunden.
# EN: Autoheal start delay in seconds.
AUTOHEAL_START_PERIOD=120

# DE: Stop-Timeout für Autoheal in Sekunden.
# EN: Autoheal stop timeout in seconds.
AUTOHEAL_DEFAULT_STOP_TIMEOUT=10

# DE: Maximale Größe einer einzelnen Container-Logdatei.
# EN: Maximum size of a single container log file.
LOG_MAX_SIZE=10m

# DE: Anzahl rotierter Logdateien pro Container.
# EN: Number of rotated log files kept per container.
LOG_MAX_FILE=3

# DE: Verzögerung bis zum Start der Minecraft-Healthchecks.
# EN: Delay before Minecraft health checks start.
MC_HEALTHCHECK_START_PERIOD=120s

# DE: Intervall der Minecraft-Healthchecks.
# EN: Interval of the Minecraft health checks.
MC_HEALTHCHECK_INTERVAL=30s

# DE: Timeout pro Minecraft-Healthcheck.
# EN: Timeout per Minecraft health check.
MC_HEALTHCHECK_TIMEOUT=10s
